r Salon","Barber Shop","Pet Groomer","Auto Repair Shop","Plumber","HVAC Contractor","Roofing Contractor","Electrician","Landscaper","Cleaning Service","Photography Studio","Law Firm","Accountant"],"type":"string","default":"Dentist / Dental Clinic","description":"Business industry to search for."},"country":{"enum":["United States","Canada","United Kingdom","Australia","New Zealand","Ireland"],"type":"string","default":"United States","description":"Country included in the Google Maps search."},"location":{"type":"string","default":"Austin, TX","maxLength":160,"minLength":1,"description":"City, neighborhood, region, state or province, or postal code to search."},"max_results":{"type":"integer","default":5,"maximum":50,"minimum":5,"description":"Maximum number of unique businesses to check and return."},"min_rating":{"type":"number","default":4,"maximum":5,"minimum":0,"description":"Minimum Maps rating used only when assigning lead_status."},"min_review_count":{"type":"integer","default":20,"minimum":0,"description":"Minimum Maps review count used only when assigning lead_status."},"exclude_chains":{"type":"boolean","default":true,"description":"When true, classify a detected multi-location chain as excluded rather than silently removing it."},"start_rank":{"type":"integer","default":1,"maximum":1000,"minimum":1,"description":"First deduplicated Google Maps feed rank eligible for this run; use the previous run's next_start_rank to continue."},"excluded_maps_urls":{"type":"string","default":"None","maxLength":200000,"minLength":1,"description":"Google Maps URLs from previous output to skip, separated only by new lines or semicolons; None means no history exclusion."}}},"recommend_desc":"Automatically find Google Maps businesses without a listed independent website. Capture business details, public contact paths, website evidence, and lead priority for web design outreach.","detail_url":"https://www.browseract.com/template/google-maps-no-website-lead-finder-api"}