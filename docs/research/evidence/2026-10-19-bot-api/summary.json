  {
    "source": "template",
    "id": "113863425622286759",
    "name": "Amazon Product Reviews Scraper Bot",
    "bot_type": "agent",
    "http_status": 200,
    "endpoint": "/v3/bots/templates/113863425622286759",
    "file": "template-113863425622286759.json",
    "top_level_fields": [
      "name",
      "description",
      "template_id",
      "bot_type",
      "created_at",
      "published_at",
      "input_schema",
      "recommend_desc",
      "detail_url"
    ],
    "input_schema": {
      "type": "object",
      "required": [
        "marketplace_url",
        "asin",
        "review_count"
      ],
      "properties": {
        "marketplace_url": {
          "type": "string",
          "default": "https://www.amazon.com",
          "pattern": "^https://[a-zA-Z0-9.-]*amazon\\.[a-z.]+/?$",
          "maxLength": 200,
          "minLength": 11,
          "description": "Amazon marketplace root URL, for example https://www.amazon.com."
        },
        "asin": {
          "type": "string",
          "default": "B085DTZQNZ",
          "pattern": "^[A-Za-z0-9]{10}$",
          "maxLength": 10,
          "minLength": 10,
          "description": "10-character Amazon product ASIN."
        },
        "review_count": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Maximum number of reviews to return."
        }
      }
    },
    "output_schema_present": false
  },
